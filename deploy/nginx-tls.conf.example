# Exemplo para Nginx da VPS, fora dos containers.
# Substitua domínio/certificados por valores reais.
server {
    listen 80;
    server_name provas.seudominio.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name provas.seudominio.com;
    ssl_certificate /etc/letsencrypt/live/provas.seudominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/provas.seudominio.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location /ws {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}

