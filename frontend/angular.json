{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "avaliacoes": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/avaliacoes",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.json",
            "styles": ["src/styles.css"],
            "allowedCommonJsDependencies": [
              "lodash",
              "lodash-es",
              "rxjs",
              "rxjs/operators",
              "rxjs/internal/operators",
              "rxjs/internal/Observable",
              "rxjs/internal/Subject",
              "rxjs/internal/Subscriber",
              "rxjs/internal/Subscription",
              "rxjs/internal/util/subscribeToArray",
              "rxjs/internal/util/subscribeToPromise",
              "rxjs/internal/util/subscribeToIterable",
              "rxjs/internal/util/subscribeToObservable",
              "@stomp/stompjs"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1MB"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "avaliacoes:build" }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
